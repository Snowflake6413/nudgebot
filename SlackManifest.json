{
  "display_information": {
    "name": "nudgebot (CHANGE ME!)",
    "description": "Nudgebot instance (CHANGE ME!)",
    "background_color": "#3e59ab"
  },
  "features": {
    "app_home": {
      "home_tab_enabled": true,
      "messages_tab_enabled": false,
      "messages_tab_read_only_enabled": false
    },
    "bot_user": {
      "display_name": "nudgebot (CHANGE ME!)",
      "always_online": true
    },
    "shortcuts": [
      {
        "name": "Delete Bot Message",
        "type": "message",
        "callback_id": "delete_bot_msg_shortcut",
        "description": "Delete a message that your nudgebot sent"
      }
    ],
    "slash_commands": [
      {
        "command": "/CHANGEME-restrict-from-channel",
        "description": "Restrict a user from joining your channel.",
        "usage_hint": "@user",
        "should_escape": true
      },
      {
        "command": "/CHANGEME-unrestrict-from-channel",
        "description": "Unrestrict a user from joining your channel.",
        "usage_hint": "@user",
        "should_escape": true
      },
      {
        "command": "/CHANGEME-list-restricted-users",
        "description": "List of restrictes users for your channel.",
        "should_escape": false
      },
      {
        "command": "/CHANGEME-advertise-channel",
        "description": "Advertise your channel to the globe!",
        "should_escape": false
      },
      {
        "command": "/CHANGEME-channel-purge",
        "description": "Kick out inactive people from your channel",
        "should_escape": false
      },
      {
        "command": "/join-channel-CHANGEME",
        "description": "Join a channel!",
        "should_escape": false
      },
      {
        "command": "/CHANGEME-about",
        "description": "About Nudgebot!",
        "should_escape": false
      },
      {
        "command": "/CHANGEME-say",
        "description": "Speak through your Nudgebot!",
        "usage_hint": "<text>",
        "should_escape": false
      }
    ]
  },
  "oauth_config": {
    "scopes": {
      "user": ["usergroups:read"],
      "bot": [
        "chat:write.public",
        "channels:history",
        "channels:manage",
        "channels:read",
        "channels:write.invites",
        "chat:write",
        "commands",
        "groups:history",
        "groups:read",
        "groups:write",
        "groups:write.invites",
        "im:history",
        "im:read",
        "im:write",
        "mpim:history",
        "mpim:read",
        "mpim:write",
        "usergroups:read",
        "usergroups:write"
      ]
    },
    "pkce_enabled": false
  },
  "settings": {
    "event_subscriptions": {
      "bot_events": [
        "app_home_opened",
        "member_joined_channel",
        "member_left_channel",
        "message.channels",
        "message.groups",
        "message.im",
        "message.mpim",
        "subteam_members_changed",
        "subteam_updated"
      ]
    },
    "interactivity": {
      "is_enabled": true
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": true,
    "token_rotation_enabled": false,
    "is_mcp_enabled": false
  }
}
